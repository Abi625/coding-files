import java.util.*;
public class searchelement{
    public static void main(String args[]){
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int arr[]=new int[n];
        for(int i=0;i<n;i++){
            arr[i]=sc.nextInt();
        }
        int temp=sc.nextInt();
        boolean found =false;
        for(int i=0;i<n;i++){
            if(arr[i]==temp){
                found = true;
                break;
            }
        }
        if(found){
            System.out.print("foundelement");
        }else{
            System.out.print("not fount element");
        }
        
    }
}
